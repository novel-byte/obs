{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2018",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "strict": true,
        "lib": [
            "DOM",
            "ES6",
            "ES7",
            "ES2018"
        ],
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts"
    ]
}